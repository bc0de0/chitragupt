# =============================================================================
# Chitragupt — Environment Variable Template
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenRouter — primary LLM gateway (routes all text-generation calls)
# Get your key at: https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Sent as HTTP headers on every OpenRouter request (improves rate-limit allowances)
OPENROUTER_SITE_URL=https://chitragupt.revorion.ai
OPENROUTER_SITE_NAME=Chitragupt

# -----------------------------------------------------------------------------
# Voyage AI — embeddings only (not available on OpenRouter)
# Get your key at: https://dash.voyageai.com
# -----------------------------------------------------------------------------
VOYAGE_API_KEY=your-voyage-api-key-here

# -----------------------------------------------------------------------------
# Model tiers — OpenRouter model IDs used by factory.py
# Change these to override model selection without touching code.
# Pinned versions only — no floating aliases.
# -----------------------------------------------------------------------------

# Primary tiers
MODEL_FAST=anthropic/claude-haiku-4-5-20251001
MODEL_STANDARD=anthropic/claude-sonnet-4-6
MODEL_PREMIUM=anthropic/claude-opus-4-7
MODEL_EMBEDDING=voyage-large-2
MODEL_STT=openai/whisper-1

# Fallback tiers (activated on provider circuit-break)
MODEL_FALLBACK_ANTHROPIC=google/gemini-2.0-flash
MODEL_FALLBACK_EMBEDDING=openai/text-embedding-3-small
MODEL_FALLBACK_STT=google/gemini-2.0-flash

# -----------------------------------------------------------------------------
# PostgreSQL — primary structured + vector store
# Connection string format: postgresql+asyncpg://user:password@host:port/dbname
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://chitragupt:changeme@localhost:5432/chitragupt

# Individual Postgres credentials (used by Docker Compose and migration tooling)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chitragupt
POSTGRES_USER=chitragupt
POSTGRES_PASSWORD=changeme

# pgvector settings
PGVECTOR_DIMENSION=1536

# -----------------------------------------------------------------------------
# Redis — session cache and budget tracker
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Object Storage — Cloudflare R2 (boto3-compatible S3 API)
# Bucket: raw document uploads and processed artefacts
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_DEFAULT_REGION=auto
S3_BUCKET_DOCUMENTS=chitragupt-documents
S3_BUCKET_ARTEFACTS=chitragupt-artefacts

# -----------------------------------------------------------------------------
# gRPC — inter-service communication
# STATE_MACHINE_ADDR: address of the Rust state machine kernel
# GRPC_PORT: port this Python service listens on for incoming gRPC calls
# -----------------------------------------------------------------------------
STATE_MACHINE_ADDR=localhost:50051
GRPC_PORT=50052

# -----------------------------------------------------------------------------
# Application settings
# -----------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
TELEMETRY_ENABLED=false      # set to true in staging/production
OTLP_ENDPOINT=http://localhost:4317

# Budget session defaults (overrides orchestration.yaml per-deployment)
SESSION_BUDGET_USD=5.00
BUDGET_CAUTION_USD=3.00
BUDGET_CRITICAL_USD=4.50
